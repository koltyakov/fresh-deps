{
  "name": "fresh-deps",
  "displayName": "Fresh Deps",
  "description": "Highlights dependencies that have newer versions available, inline in your manifest files.",
  "version": "0.2.1",
  "license": "MIT",
  "publisher": "koltyakov",
  "repository": {
    "type": "git",
    "url": "https://github.com/koltyakov/fresh-deps.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "dependencies",
    "outdated",
    "updates",
    "npm",
    "go",
    "python",
    "cargo",
    "maven",
    "nuget"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#0b4d80",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:go.mod",
    "onLanguage:gomod",
    "onLanguage:toml",
    "onLanguage:xml",
    "onLanguage:pip-requirements",
    "workspaceContains:**/package.json",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/Pipfile",
    "workspaceContains:**/requirements*.txt",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.fsproj",
    "workspaceContains:**/*.vbproj",
    "workspaceContains:**/Directory.Packages.props",
    "workspaceContains:**/Directory.Build.props",
    "workspaceContains:**/packages.config"
  ],
  "contributes": {
    "commands": [
      {
        "command": "freshDeps.refresh",
        "title": "Fresh Deps: Check for Updates",
        "icon": "$(refresh)"
      },
      {
        "command": "freshDeps.toggle",
        "title": "Fresh Deps: Toggle Inline Hints"
      },
      {
        "command": "freshDeps.clearCache",
        "title": "Fresh Deps: Clear Version Cache"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "freshDeps.refresh",
          "when": "freshDeps.supportedFile",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Fresh Deps",
      "properties": {
        "freshDeps.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline hints for dependencies that have newer versions."
        },
        "freshDeps.cacheDurationMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How long resolved versions are cached before the registry is queried again."
        },
        "freshDeps.audit.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show security audit warnings using the configured npm registry's audit API or public PyPI. Sends package names and baseline versions to that registry. Checks manifest declarations, not installed or transitive dependencies. Other ecosystems and custom Python indexes are not supported."
        },
        "freshDeps.concurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of parallel registry requests."
        },
        "freshDeps.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "Timeout for a single registry request, in milliseconds."
        },
        "freshDeps.showSatisfyingUpdates": {
          "type": "boolean",
          "default": true,
          "description": "When the latest version is outside the declared range, also report the newest version that still satisfies it."
        },
        "freshDeps.includePrerelease": {
          "type": "boolean",
          "default": false,
          "description": "Consider prerelease versions (for example 2.0.0-beta.1) as updates."
        },
        "freshDeps.npm.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check npm dependencies in package.json."
        },
        "freshDeps.npm.registry": {
          "type": "string",
          "default": "",
          "description": "npm registry URL. Leave empty to read it from .npmrc, falling back to https://registry.npmjs.org."
        },
        "freshDeps.npm.sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dependencies",
            "devDependencies",
            "peerDependencies",
            "optionalDependencies",
            "volta"
          ],
          "description": "package.json sections to inspect, including Volta tool pins in volta."
        },
        "freshDeps.go.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check Go modules in go.mod."
        },
        "freshDeps.go.proxy": {
          "type": "string",
          "default": "",
          "description": "Go module proxy URL. Leave empty to read GOPROXY, falling back to https://proxy.golang.org."
        },
        "freshDeps.go.includeIndirect": {
          "type": "boolean",
          "default": false,
          "description": "Also check modules marked as // indirect."
        },
        "freshDeps.go.checkMajorVersions": {
          "type": "boolean",
          "default": true,
          "description": "Probe for newer major versions (/v2, /v3, ...) of Go modules."
        },
        "freshDeps.python.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check Python dependencies in pyproject.toml, Pipfile and requirements files."
        },
        "freshDeps.python.indexUrl": {
          "type": "string",
          "default": "",
          "description": "Python package index URL. Leave empty to read PIP_INDEX_URL, UV_INDEX_URL or pip's configuration, falling back to https://pypi.org/simple."
        },
        "freshDeps.python.includeBuildRequires": {
          "type": "boolean",
          "default": false,
          "description": "Also check [build-system] requires in pyproject.toml."
        },
        "freshDeps.rust.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check Rust crates in Cargo.toml."
        },
        "freshDeps.dotnet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check NuGet dependencies in .NET project and package management files."
        },
        "freshDeps.dotnet.indexUrl": {
          "type": "string",
          "default": "",
          "description": "NuGet V3 service index URL. Leave empty to use https://api.nuget.org/v3/index.json."
        },
        "freshDeps.java.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check Maven dependencies in pom.xml."
        },
        "freshDeps.java.repository": {
          "type": "string",
          "default": "",
          "description": "Maven repository URL. Leave empty to use https://repo.maven.apache.org/maven2."
        }
      }
    },
    "colors": [
      {
        "id": "freshDeps.commentForeground",
        "description": "Colour of the leading comment token on an inline hint.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      },
      {
        "id": "freshDeps.majorForeground",
        "description": "Inline hint colour for major updates \u2014 the ones that need a range bump or a new import path.",
        "defaults": {
          "dark": "editorWarning.foreground",
          "light": "editorWarning.foreground",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      },
      {
        "id": "freshDeps.minorForeground",
        "description": "Inline hint colour for minor updates.",
        "defaults": {
          "dark": "editorInfo.foreground",
          "light": "editorInfo.foreground",
          "highContrast": "editorInfo.foreground",
          "highContrastLight": "editorInfo.foreground"
        }
      },
      {
        "id": "freshDeps.patchForeground",
        "description": "Inline hint colour for patch updates.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      },
      {
        "id": "freshDeps.prereleaseForeground",
        "description": "Inline hint colour for prerelease updates.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.js",
    "package": "npm run build && vsce package",
    "vscode:install": "node scripts/vscode-install.mjs"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/semver": "^7.8.0",
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  }
}
